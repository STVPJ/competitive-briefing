# Required for the compose step (one Claude call per edition per run).
ANTHROPIC_API_KEY=

# Optional: Brave Search API (free tier: 2,000 queries/month). Without it, feeds + Reddit only.
BRAVE_API_KEY=

# Optional: TypeSafe Jev for same-story judgement. Without it, the story ledger
# uses its word-overlap fallback (logged at startup).
TYPESAFE_API_KEY=

# Contact string sent in User-Agent headers to feeds and Reddit (a URL or email).
BRIEFING_CONTACT=https://github.com/your-name/competitive-briefing

# Where state (history, story ledger, feed health) and briefings are written.
DATA_DIR=./data
OUTPUT_DIR=./output
# BRIEFING_CONFIG=config/briefing.json

# Optional email delivery. Port 465 = implicit TLS; anything else uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated; used when an edition's "recipients" list is empty.
BRIEFING_RECIPIENTS=
